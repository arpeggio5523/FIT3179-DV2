{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Townsville’s changing breed rankings",
    "subtitle": [
      "March snapshots, 2023–2026",
      "Six focus breeds in colour; other selected breeds in grey"
    ],
    "anchor": "start"
  },
  "width": 600,
  "height": 680,
  "data": {
    "url": "diagrams/townsville_breeds_bump/townsville_breed_ranks.json"
  },
  "transform": [
    {
      "calculate": "[2021, 2022, 2023, 2024, 2025, 2026]",
      "as": "Years"
    },
    {
      "flatten": ["Years", "Ranks", "Counts"],
      "as": ["Year", "Rank", "Count"]
    },
    {
      "filter": "datum.Year >= 2023 && datum.Year <= 2026"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "Rank",
          "as": "BestRankInPeriod"
        }
      ],
      "groupby": ["Breed"]
    },
    {
      "filter": "datum.Focus || datum.BestRankInPeriod <= 35"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "sort": [2023, 2024, 2025, 2026],
      "title": "March snapshot",
      "axis": {
        "labelAngle": 0,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "scale": {
        "domain": [35.5, 0.5],
        "nice": false,
        "zero": false
      },
      "title": "Rank (values above 35 displayed at 35)",
      "axis": {
        "values": [1, 5, 10, 15, 20, 25, 30, 35],
        "format": "d",
        "grid": true,
        "gridColor": "#F1F3F5"
      }
    },
    "detail": {
      "field": "Breed"
    },
    "order": {
      "field": "Year",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "Breed",
        "type": "nominal",
        "title": "Breed"
      },
      {
        "field": "Year",
        "type": "ordinal",
        "title": "March snapshot"
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "title": "Displayed rank (35 = 35 or worse)",
        "format": "d"
      },
      {
        "field": "Count",
        "type": "quantitative",
        "title": "Dog records",
        "format": ",d"
      }
    ]
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!datum.Focus"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.3,
        "color": "#C5CBD0",
        "opacity": 0.7,
        "clip": true
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.Focus && isValid(datum.Rank) && datum.Rank <= 35"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 24,
        "color": "#B4BDC4",
        "opacity": 0.8
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Focus"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "Breed",
          "type": "nominal",
          "scale": {
            "domain": [
              "Maltese Terrier Cross",
              "Staffordshire Bull Terrier",
              "Staffordshire Bull Terrier Cross",
              "Jack Russell Terrier",
              "Dachshund",
              "Miniature Dachshund"
            ],
            "range": [
              "#0072B2",
              "#C46124",
              "#A04F91",
              "#237B91",
              "#638C31",
              "#6048AF"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Focus && isValid(datum.Rank) && datum.Rank <= 35"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 85,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "Breed",
          "type": "nominal",
          "scale": {
            "domain": [
              "Maltese Terrier Cross",
              "Staffordshire Bull Terrier",
              "Staffordshire Bull Terrier Cross",
              "Jack Russell Terrier",
              "Dachshund",
              "Miniature Dachshund"
            ],
            "range": [
              "#0072B2",
              "#C46124",
              "#A04F91",
              "#237B91",
              "#638C31",
              "#6048AF"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Focus && datum.Year === 2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Breed"
        },
        "color": {
          "field": "Breed",
          "type": "nominal",
          "scale": {
            "domain": [
              "Maltese Terrier Cross",
              "Staffordshire Bull Terrier",
              "Staffordshire Bull Terrier Cross",
              "Jack Russell Terrier",
              "Dachshund",
              "Miniature Dachshund"
            ],
            "range": [
              "#0072B2",
              "#C46124",
              "#A04F91",
              "#237B91",
              "#638C31",
              "#6048AF"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
